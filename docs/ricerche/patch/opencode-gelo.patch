+// Quali colture proteggere stasera (Node). Uso: node tests/fase5-avviso-gelo.mjs <cartella-app>
+import path from 'node:path';
+import fs from 'node:fs';
+import { pathToFileURL } from 'node:url';
+const radice = path.resolve(process.argv[2] || '.');
+const { coltureDaProteggere } = await import(pathToFileURL(path.join(radice, 'js/motore/avviso-gelo.js')).href);
+let ok = 0, ko = 0;
+const check = (n, c, d = '') => { c ? ok++ : ko++; console.log(`${c ? 'PASS' : 'FAIL'}  ${n}${d ? '  -> ' + d : ''}`); };
+const rd = (f) => JSON.parse(fs.readFileSync(path.join(radice, f), 'utf8'));
+const dati = { colture: {
+  basilico: { freddo: { tolleranza: 'muore-col-gelo', soglia_c: null }, fine_stagione: { azione: 'raccogliere-tutto', cosa_fare: 'Raccogli.', come: 'Taglia.', perche: 'Gelo.', certezza: 'media' } },
+  fave: { freddo: { tolleranza: 'resiste-al-gelo', soglia_c: -8 }, fine_stagione: { azione: 'lasciare-in-campo', cosa_fare: 'x', come: 'y', perche: 'z', certezza: 'media' } },
+} };
+const schede = ['basilico', 'fave'].map((id) => rd(`data/it/colture/${id}.json`));
+const colt = [
+  { id: 'b', nome: 'Basilico', schedaId: 'basilico', dataSemina: '2026-09-10', partenza: 'piantina' },
+  { id: 'f', nome: 'Fave', schedaId: 'fave', dataSemina: '2026-09-10', partenza: 'seme' },
+  { id: 's', nome: 'Senza scheda', schedaId: 'nonesiste', dataSemina: '2026-09-10' },
+];
+const base = { colture: colt, schede, zonaId: 'castelli-romani', dati, oggi: '2026-11-02' };
+let r = coltureDaProteggere({ ...base, minime: [8, 1, 4] });
+check('con minima 1: solo il basilico, con cosa fare e minima', r.minima === 1 && r.colture.length === 1 && r.colture[0].id === 'b' && r.colture[0].cosaFare === 'Raccogli.' && r.colture[0].azione === 'raccogliere-tutto', JSON.stringify(r));
+r = coltureDaProteggere({ ...base, minime: [8, 6] });
+check('senza gelo: niente', r.minima === null && r.colture.length === 0);
+check('input strani non lanciano', [undefined, null, {}, { colture: [null] }, { ...base, colture: null }, { ...base, minime: 'x' }].every((x) => { const v = coltureDaProteggere(x); return v.minima === null && v.colture.length === 0; }));
+console.log(`\nTotale: ${ok} PASS, ${ko} FAIL`);
+process.exit(ko ? 1 : 0);
