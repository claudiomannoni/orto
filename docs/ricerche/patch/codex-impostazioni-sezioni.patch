diff --git a/tests/impostazioni-sezioni.mjs b/tests/impostazioni-sezioni.mjs
new file mode 100644
index 0000000..752a351
--- /dev/null
+++ b/tests/impostazioni-sezioni.mjs
@@ -0,0 +1,22 @@
+import { readFileSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+
+const root = resolve(process.argv[2] || '.');
+const source = readFileSync(join(root, 'js/screens/impostazioni.js'), 'utf8');
+const i18n = JSON.parse(readFileSync(join(root, 'i18n/it.json'), 'utf8'));
+const gruppi = ['orto', 'personalizza', 'assistenza', 'dati'];
+const fallimenti = [];
+const verifica = (condizione, messaggio) => { if (!condizione) fallimenti.push(messaggio); };
+
+verifica(source.includes("class: 'contenuto-secondario impostazioni-gruppo'"), 'I gruppi devono usare il contenitore espandibile standard.');
+verifica(source.includes('open: Boolean(aperto)'), 'Il gruppo iniziale deve poter essere aperto senza script aggiuntivi.');
+verifica(source.includes('gruppo.open = true'), 'L’indice deve aprire il gruppo prima di raggiungerlo.');
+verifica(source.includes('sezioneOrto(s)') && source.includes('sezioneSeguite(s)'), 'Le impostazioni dell’orto e delle colture seguite devono restare raggiungibili.');
+verifica(source.includes('sezioneAccessibilita(s)') && source.includes('sezioneVermetti(s)'), 'Accessibilità e mascotte devono restare raggiungibili.');
+verifica(source.includes('sezioneMeteo(s)') && source.includes('sezioneIA(s)'), 'Meteo e configurazione IA devono restare raggiungibili.');
+verifica(source.includes('sezioneBackup()') && source.includes("t('info.versione'"), 'Backup e informazioni versione devono restare raggiungibili.');
+for (const gruppo of gruppi) verifica(typeof i18n['impostazioni.gruppo.' + gruppo] === 'string', 'Manca la traduzione del gruppo ' + gruppo + '.');
+
+console.log((fallimenti.length ? 'FAIL' : 'PASS') + ' impostazioni espandibili: ' + gruppi.length + ' gruppi, ' + fallimenti.length + ' errori');
+for (const errore of fallimenti) console.log('FAIL ' + errore);
+process.exit(fallimenti.length ? 1 : 0);
\ No newline at end of file
