+// Origine della coltura e data approssimativa: normalizzazione e retrocompatibilità (Node, nessun server).
+// Uso: node tests/origine-colture.mjs <cartella-app>
+import { pathToFileURL } from 'node:url';
+import path from 'node:path';
+import fs from 'node:fs';
+const cartella = path.resolve(process.argv[2] || '.');
+let ok = 0, ko = 0;
+const check = (n, c, d = '') => { c ? ok++ : ko++; console.log(`${c ? 'PASS' : 'FAIL'}  ${n}${d ? '  -> ' + d : ''}`); };
+
+const dati = await import(pathToFileURL(path.join(cartella, 'js/store/dati.js')).href);
+const fasiPianta = await import(pathToFileURL(path.join(cartella, 'js/ui/fasi-pianta.js')).href);
+const { normalizzaColtura, ORIGINI } = dati;
+const { testoEta } = fasiPianta;
+
+// Una coltura vecchia: come le versioni precedenti dell'app la salvavano (senza i nuovi campi).
+const vecchia = (extra = {}) => ({
+  id: 'v1', nome: 'Fave', varieta: 'Vola', dataSemina: '2026-10-20', dove: 'orto',
+  partenza: 'seme', note: 'vecchia', creata: '2026-10-20T08:00:00.000Z', schedaId: null, zonaId: 'z1', schemaVersion: 2,
+  ...extra,
+});
+
+// 1. Record vecchio senza i nuovi campi: occupa un posto e non cambia le cose.
+{
+  const n = normalizzaColtura(vecchia());
+  check('vecchio record: campi intatti', n.nome === 'Fave' && n.dataSemina === '2026-10-20' && n.creata === '2026-10-20T08:00:00.000Z' && n.zonaId === 'z1' && n.schemaVersion === 2, JSON.stringify(n));
+  check('vecchio record: origine derivata seme (nessuna informazione inventata)', n.origine === 'seme');
+  check('vecchio record: dataApprossimativa false', n.dataApprossimativa === false);
+  const p = normalizzaColtura(vecchia({ partenza: 'piantina' }));
+  check('vecchio record piantina: origine e partenza restano piantina', p.origine === 'piantina' && p.partenza === 'piantina');
+  const vuota = normalizzaColtura({ nome: 'Z', dataSemina: '2026-10-20' });
+  check('nessuna origine né partenza: come prima (seme)', vuota.origine === 'seme' && vuota.partenza === 'seme');
+}
+
+// 2. Le origini nuove si salvano e restano nella forma giusta.
+for (const o of ORIGINI) {
+  const n = normalizzaColtura({ nome: 'Asparago', dataSemina: '2026-10-01', origine: o });
+  check(`origine ${o}: raccontata com'è`, n.origine === o, n.origine);
+  check(`origine ${o}: partenza per il motore fasi resta seme o piantina`, n.partenza === 'seme' || n.partenza === 'piantina', n.partenza);
+}
+{
+  const n = normalizzaColtura({ nome: 'Cipoletta', dataSemina: '2026-10-01', origine: 'piantina' });
+  check('origine piantina: partenza diventa piantina', n.partenza === 'piantina');
+  const s = normalizzaColtura({ nome: 'Zampa di asparago', dataSemina: '2026-10-01', origine: 'organo', partenza: 'piantina' });
+  check('organo con partenza piantina contraddittoria: sopravvive qualcosa di sensato', (s.partenza === 'piantina' || s.partenza === 'seme') && s.origine === 'organo', `${s.origine}/${s.partenza}`);
+}
+
+// 3. Origine sbagliata/vecchia non fa perdere il record.
+{
+  const n = normalizzaColtura({ nome: 'Ravanelli', dataSemina: '2026-10-01', origine: 'da_spazio_esterno', partenza: 'seme' });
+  check('origine inventata: si parte dai valori sicuri (seme)', n.origine === 'seme' && n.partenza === 'seme');
+  const p = normalizzaColtura({ nome: 'Basilico', dataSemina: '2026-10-01', origine: null, partenza: 'piantina' });
+  check('origine null con partenza piantina: si mantiene il dato piantina', p.origine === 'piantina' && p.partenza === 'piantina');
+}
+
+// 4. La trattazione della data: approssimativa solo con true esplicito.
