diff --git a/js/ai/guida-locale.js b/js/ai/guida-locale.js
new file mode 100644
index 0000000..cafb42e
--- /dev/null
+++ b/js/ai/guida-locale.js
@@ -0,0 +1,53 @@
+import { etaDellaPianta, faseAttuale } from '../motore/fasi.js';
+
+function dataValida(data) {
+  if (typeof data !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(data)) return false;
+  const valore = new Date(data + 'T00:00:00Z');
+  return !Number.isNaN(valore.getTime()) && valore.toISOString().slice(0, 10) === data;
+}
+
+// Crea una guida soltanto dai dati locali presenti. Non deduce date o cure mancanti.
+export function guidaLocale({ coltura = null, scheda, datiFasi, datiRaccolta, oggi } = {}) {
+  if (!scheda?.id) return { disponibile: false, motivo: 'scheda' };
+  const dati = datiFasi?.colture?.[scheda.id];
+  const fasi = Array.isArray(dati?.fasi) ? dati.fasi : [];
+  const raccolta = datiRaccolta?.colture?.[scheda.id] ?? null;
+  if (!fasi.length && !raccolta) return { disponibile: false, motivo: 'dati', nome: scheda.nome };
+
+  const origine = coltura?.origine;
+  const origineCompatibile = origine
+    ? ['seme', 'piantina'].includes(origine)
+    : ['seme', 'piantina'].includes(coltura?.partenza);
+  const data = coltura?.dataSemina;
+  const dataInIntervallo = dataValida(data) && data <= oggi && dataValida(oggi);
+  const tracciabile = Boolean(coltura && origineCompatibile && dataInIntervallo);
+  const daPiantina = origine ? origine === 'piantina' : coltura?.partenza === 'piantina';
+  const eta = tracciabile
+    ? etaDellaPianta({ partenza: daPiantina ? 'piantina' : 'seme', data, piantinaEta: coltura.piantinaEta }, oggi)
+    : null;
+  const stato = eta == null ? null : faseAttuale(fasi, eta);
+
+  return {
+    disponibile: true,
+    nome: scheda.nome,
+    schedaId: scheda.id,
+    varieta: coltura?.varieta || '',
+    tracciata: Boolean(coltura),
+    origine,
+    daPiantina,
+    dataApprossimativa: coltura?.dataApprossimativa === true,
+    eta,
+    fase: stato?.fase ?? null,
+    giorniAllaProssima: stato?.giorniAllaProssima ?? null,
+    prossima: stato ? fasi[stato.indice + 1] ?? null : null,
+    fasi: fasi.map((f) => ({
+      id: f.id,
+      nome: f.nome,
+      da_giorno: f.da_giorno,
+      cosa_fare: Array.isArray(f.cosa_fare) ? f.cosa_fare : [],
+      accortezze: Array.isArray(f.accortezze) ? f.accortezze : [],
+      certezza: ['alta', 'media', 'bassa'].includes(f.certezza) ? f.certezza : 'bassa',
+    })),
+    raccolta,
+  };
+}
