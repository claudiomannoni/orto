+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+import { guidaLocale } from '../js/ai/guida-locale.js';
+
+const root = resolve(import.meta.dirname, '..');
+
+const oggi = '2026-11-02';
+const scheda = { id: 'fave', nome: 'Fave' };
+const datiFasi = { colture: { fave: { fasi: [
+  { id: 'semina', nome: 'Semina', da_giorno: 0, a_giorno: 9, cosa_fare: ['Controlla il terreno'], accortezze: ['Evita i ristagni'], certezza: 'media' },
+  { id: 'crescita', nome: 'Crescita', da_giorno: 10, a_giorno: null, cosa_fare: ['Osserva le foglie'], accortezze: [], certezza: 'alta' },
+] } } };
+const datiRaccolta = { colture: { fave: { quando_raccogliere: 'Quando i baccelli sono pieni', come_raccogliere: 'Stacca con cura', conservazione: [] } } };
+const contenutoRaccolta = JSON.parse(readFileSync(join(root, 'data/it/raccolta.json'), 'utf8'));
+const testoRaccolta = readFileSync(join(root, 'data/it/raccolta.json'), 'utf8');
+assert.equal(testoRaccolta.split('"asparagi":').length - 1, 1);
+const guidaAsparagi = contenutoRaccolta.colture.asparagi;
+assert.ok(guidaAsparagi?.quando_raccogliere && guidaAsparagi?.come_raccogliere);
+assert.ok(guidaAsparagi.fonti.every((id) => contenutoRaccolta.fonti[id]));
+assert.ok(guidaAsparagi.conservazione.every((c) => c.fonti.every((id) => contenutoRaccolta.fonti[id])));
+const seme = { id: 'c1', schedaId: 'fave', dataSemina: '2026-11-01', partenza: 'seme', nome: 'Fave' };
+
+const guida = guidaLocale({ coltura: seme, scheda, datiFasi, datiRaccolta, oggi });
+assert.equal(guida.disponibile, true);
+assert.equal(guida.tracciata, true);
+assert.equal(guida.eta, 1);
+assert.equal(guida.fase.id, 'semina');
+assert.equal(guida.prossima.id, 'crescita');
+assert.equal(guida.giorniAllaProssima, 9);
+assert.equal(guida.raccolta.quando_raccogliere, 'Quando i baccelli sono pieni');
+
+const trapianto = guidaLocale({
+  coltura: { ...seme, partenza: 'piantina', dataSemina: '2026-10-20', piantinaEta: 14, dataApprossimativa: true },
+  scheda, datiFasi, oggi,
+});
+assert.equal(trapianto.eta, 27);
+assert.equal(trapianto.daPiantina, true);
+assert.equal(trapianto.dataApprossimativa, true);
+assert.equal(trapianto.fase.id, 'crescita');
+
+const nonRegistrata = guidaLocale({ scheda, datiFasi, oggi });
+assert.equal(nonRegistrata.disponibile, true);
+assert.equal(nonRegistrata.tracciata, false);
+assert.equal(nonRegistrata.eta, null);
+assert.equal(nonRegistrata.fase, null);
+assert.equal(nonRegistrata.fasi.length, 2);
+
+const spontanea = guidaLocale({
+  coltura: { ...seme, origine: 'spontanea', dataSemina: '2026-11-01' },
+  scheda, datiFasi, oggi,
+});
+assert.equal(spontanea.tracciata, true);
+assert.equal(spontanea.eta, null);
+assert.equal(spontanea.fase, null);
+
+const dataFutura = guidaLocale({
+  coltura: { ...seme, dataSemina: '2026-11-03' },
+  scheda, datiFasi, oggi,
+});
+assert.equal(dataFutura.eta, null);
+
+assert.equal(guidaLocale({ scheda, datiFasi: { colture: {} }, oggi }).disponibile, false);
+assert.equal(guidaLocale({ scheda, datiFasi: { colture: {} }, datiRaccolta, oggi }).disponibile, true);
+assert.equal(guidaLocale({ datiFasi, oggi }).disponibile, false);
+
+console.log('PASS guida locale: fase, trapianto, origine incerta, date future, raccolta e dati mancanti');
+const ids = JSON.parse(readFileSync(join(root, 'data/it/colture/indice.json'), 'utf8')).colture;
